# Offline backend Dockerfile: uses a lightweight python base and skips APT installs.
# This image is intended for offline development/testing where system packages
# (tesseract, ffmpeg, libpq-dev) are not required. It avoids network package
# downloads during build.

FROM python:3.11-slim AS base

WORKDIR /app

# Copy trimmed Python requirements (already present in repo)
COPY requirements.docker.txt ./requirements.docker.txt

# Install Python packages only (no apt-get network usage)
RUN pip install --no-cache-dir -r requirements.docker.txt || true

# Production stage
FROM python:3.11-slim
WORKDIR /app

# Copy site-packages from builder if available
COPY --from=base /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=base /usr/local/bin /usr/local/bin

# Copy application code
COPY . .

RUN mkdir -p logs uploads data

RUN adduser --disabled-password --gecos '' --uid 1000 appuser \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
